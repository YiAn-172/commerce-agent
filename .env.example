COMPOSE_PROJECT_NAME=commerce-agent
APP_ENV=local
APP_SECRET=change-me-before-use
DEMO_AUTH_ENABLED=true
LOG_LEVEL=INFO
MCP_INTERNAL_TOKEN=change-me-mcp-internal-token

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_SECONDS=30
DEEPSEEK_MAX_RETRIES=1
DEEPSEEK_TEMPERATURE=0.1

MYSQL_DATABASE=commerce
MYSQL_USER=commerce
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-root-me
MYSQL_DSN=mysql+asyncmy://commerce:change-me@mysql:3306/commerce
REDIS_URL=redis://redis:6379/0
ELASTICSEARCH_URL=http://elasticsearch:9200
MILVUS_URI=http://milvus:19530

CHECKPOINT_DB=/cache/checkpoints/checkpoints.sqlite
APPROVAL_CHECKPOINT_DB=/cache/checkpoints/approval-checkpoints.sqlite
JWT_TTL_SECONDS=3600
SSE_RETENTION_SECONDS=600
SSE_HEARTBEAT_SECONDS=15
INTENT_MODEL_PATH=/workspace/models/intent_classifier/current
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
RERANKER_MODEL=BAAI/bge-reranker-base
HF_HOME=/cache/huggingface

DIRECT_ROUTE_THRESHOLD=0.78
CLARIFY_THRESHOLD=0.55
ROUTE_MARGIN=0.20
MAX_GRAPH_STEPS=30
MAX_TOOL_CALLS=5
MAX_LLM_CALLS=3
